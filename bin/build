#!/usr/bin/env bash
# build — compile bsctl (ctl/) and install it into ~/.local/bin.
#
# Release build via cargo; installed with plain install(1), NOT `cargo
# install` — that would strew registry metadata under ~/.local. The binary
# lands on PATH next to the stowed scripts; consumers (hooks/widgets) opt in
# by calling it, so installing it changes nothing until they do.
set -euo pipefail

self=$(readlink -f "$0"); BIN=$(dirname "$self"); REPO=$(dirname "$BIN")
# shellcheck source=bin/lib.sh
. "$BIN/lib.sh"
cd "$REPO"

for a in "${@:-}"; do
  case "$a" in
    -h|--help) awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else exit }' "$self"; exit 0 ;;
    "") ;;
    *) echo "build: unknown argument: $a (try --help)" >&2; exit 2 ;;
  esac
done

printf '%sbattlestation build%s\n' "$C_BLD" "$C_RST"

hdr "cargo build (release)"
if ! have cargo; then
  bad "cargo not found — install the rust toolchain first"
  exit 1
fi
cargo build --release --manifest-path ctl/Cargo.toml
ok "built ctl/target/release/bsctl"

hdr "install"
dest="$HOME/.local/bin/bsctl"
mkdir -p "$(dirname "$dest")"   # BSD install(1) has no -D
install -m755 ctl/target/release/bsctl "$dest"
ok "installed $dest ($(du -h "$dest" | cut -f1))"

hdr "Battlestation.app (board/, macOS)"
if [ "$(uname -s)" != Darwin ] || [ -z "$(git ls-files -- board/)" ]; then
  info "not macOS — skipping"
elif ! have swift; then
  bad "swift not found — install the Xcode command line tools: xcode-select --install"
  exit 1
else
  swift build -c release --package-path board
  bin_dir=$(swift build -c release --package-path board --show-bin-path)
  app="$HOME/Applications/Battlestation.app"
  # The harness glyphs' one source of truth is the bar plugin's asset dir;
  # the app bundles a copy, refreshed on every build.
  assets="stow/home-linux/noctalia/.config/noctalia/plugins/battlestation-workspaces/assets"
  stage="$app.staging"
  rm -rf "$stage"
  mkdir -p "$stage/Contents/MacOS" "$stage/Contents/Resources"
  install -m755 "$bin_dir/Battlestation" "$stage/Contents/MacOS/Battlestation"
  cp board/Info.plist "$stage/Contents/Info.plist"
  cp -R "$assets" "$stage/Contents/Resources/assets"
  codesign --force --sign - "$stage" >/dev/null 2>&1   # ad-hoc: local use only
  rm -rf "$app" && mv "$stage" "$app"
  # Register the battlestation:// URL scheme with LaunchServices.
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
  ok "installed $app"
  # Restart a running copy (the launchd agent restarts it on a non-zero exit).
  if launchctl print "gui/$(id -u)/local.battlestation.board" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/$(id -u)/local.battlestation.board" && ok "restarted the running app"
  fi
fi

hdr "fish completions"
# Untracked build artifact, same class as the binary itself: regenerated from
# the installed binary on every build, never stowed or tracked.
comp="$HOME/.config/fish/completions/bsctl.fish"
mkdir -p "$(dirname "$comp")"
"$dest" completions fish > "$comp"
ok "generated $comp"
