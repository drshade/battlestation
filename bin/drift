#!/usr/bin/env bash
# drift — show what the machine has that the repo doesn't manage.
#
# Read-only ALWAYS: drift never changes the system or the repo. Its output is a
# triage list, not an error — drift is normal, invisible drift is the bug.
# Adopting a config or installing a package is a deliberate manual step.
#
# Reports: unmanaged ~/.config entries and ~/.local/share/applications, and
# installed packages vs the packages/*.txt manifests (bin/install-packages
# applies those; this only reports).
set -euo pipefail

self=$(readlink -f "$0"); BIN=$(dirname "$self"); REPO=$(dirname "$BIN")
# shellcheck source=bin/lib.sh
. "$BIN/lib.sh"
cd "$REPO"

for a in "${@:-}"; do
  case "$a" in
    -h|--help) awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else exit }' "$self"; exit 0 ;;
    "") ;;
    *) echo "drift: unknown argument: $a (try --help)" >&2; exit 2 ;;
  esac
done

# Runtime/state/cache dirs that are never dotfiles — a report FILTER, not a
# correctness mechanism. Edit freely; suppressed count is always shown.
# Triaged 2026-07-05: app-private state (discord, teams-for-linux, shelly,
# cachyos*), Noctalia TEMPLATE outputs (gtk-3.0/4.0, qt5ct/qt6ct, kdeglobals
# — the derived-output class, regenerated on every theme change), xdg-user-dirs
# generated files, and kdeconnect (pairing certs + PRIVATE KEY — machine
# state that must never be adopted into a published repo).
NOISE=(pulse dconf session mozilla gh ghc uv nautilus
  discord teams-for-linux shelly cachyos cachyos-hello.json
  gtk-3.0 gtk-4.0 qt5ct qt6ct kdeglobals
  user-dirs.dirs user-dirs.locale
  kdeconnect riptide)
# Same idea for ~/.local/share/applications: entries written by tools about
# themselves, not configuration to adopt.
APP_NOISE=(claude-code-url-handler.desktop)

printf '%sbattlestation drift%s  %s(read-only report)%s\n' "$C_BLD" "$C_RST" "$C_DIM" "$C_RST"

# True if $1 (a path) is, or contains within 4 levels, a symlink into the repo.
managed() {
  local e=$1 l
  if [ -L "$e" ]; then case "$(readlink -f "$e" 2>/dev/null)" in "$REPO"/*) return 0 ;; esac; fi
  while IFS= read -r -d '' l; do
    case "$(readlink -f "$l" 2>/dev/null)" in "$REPO"/*) return 0 ;; esac
  done < <(find "$e" -maxdepth 4 -type l -print0 2>/dev/null)
  return 1
}

is_noise() { local n=$1 x; for x in "${NOISE[@]}"; do [ "$x" = "$n" ] && return 0; done; return 1; }

# Skel comparison: an unmanaged entry that is byte-identical to its
# /etc/skel counterpart is just the installer's untouched default — not
# customization to adopt, so suppress it (with a count). The moment it
# DIVERGES from skel it reappears, annotated — that divergence is exactly
# the "you changed something; adopt or revert it" signal. (Verified
# 2026-07-02: CachyOS ships gtk/qt6ct/xsettingsd/uwsm/… via skel, owned by
# cachyos-hypr-noctalia.)
# Returns: 0 = identical to skel, 1 = no skel counterpart, 2 = diverged.
skel_state() {
  local rel=$1
  local skel="/etc/skel/$rel" mine="$HOME/$rel"
  [ -e "$skel" ] || return 1
  diff -rq "$skel" "$mine" >/dev/null 2>&1 && return 0
  return 2
}

# --- 1. unmanaged ~/.config -------------------------------------------------
hdr "Unmanaged in ~/.config"
suppressed=0 unmanaged=0 skel_same=0
for e in "$HOME"/.config/*; do
  [ -e "$e" ] || continue
  n=$(basename "$e")
  if is_noise "$n"; then suppressed=$((suppressed + 1)); continue; fi
  if managed "$e"; then continue; fi
  skel_state ".config/$n" && { skel_same=$((skel_same + 1)); continue; }
  st=$?
  [ -d "$e" ] && kind="dir" || kind="file"
  if [ "$st" -eq 2 ]; then
    info "$n ($kind, differs from skel)"
  else
    info "$n ($kind)"
  fi
  unmanaged=$((unmanaged + 1))
done
[ "$unmanaged" -eq 0 ] && ok "nothing unmanaged (outside the noise/skel filters)"
[ "$skel_same" -gt 0 ] && info "($skel_same untouched installer defaults suppressed: identical to /etc/skel)"
[ "$suppressed" -gt 0 ] && info "($suppressed suppressed by the noise filter: ${NOISE[*]})"

# --- 2. unmanaged ~/.local/share/applications -------------------------------
hdr "Unmanaged desktop entries (~/.local/share/applications)"
appdir="$HOME/.local/share/applications"
if [ -d "$appdir" ]; then
  app_unmanaged=0 app_noise=0
  for f in "$appdir"/*.desktop; do
    [ -e "$f" ] || continue
    if [ -L "$f" ]; then case "$(readlink -f "$f" 2>/dev/null)" in "$REPO"/*) continue ;; esac; fi
    b=$(basename "$f")
    skip=0
    for n in "${APP_NOISE[@]}"; do [ "$b" = "$n" ] && { skip=1; break; }; done
    if [ "$skip" -eq 1 ]; then app_noise=$((app_noise + 1)); continue; fi
    info "$b"
    app_unmanaged=$((app_unmanaged + 1))
  done
  [ "$app_noise" -gt 0 ] && info "($app_noise suppressed by the noise filter)"
  [ "$app_unmanaged" -eq 0 ] && ok "none"
else
  info "no $appdir"
fi

# --- 3. installed packages vs manifest (needs P3.8) -------------------------
hdr "Package manifest drift"
pkg_diff() {
  # pkg_diff <label> <listcmd> <ignore_file> <manifest>... — the declared set is
  # the UNION of every manifest file that exists (pacman splits into the accepted
  # installer baseline pacman-base.txt + deliberate additions pacman.txt).
  #
  # <ignore_file> ("" or a missing path for none) is the EXCLUDE list: package
  # names/globs whose PRESENCE is never drift — per-machine hardware (GPU / CPU
  # microcode / vendor accel) in a config shared across machines. Matches are
  # filtered out of "installed but not in manifest" silently — no line, no count.
  # install-packages ignores this file: it only installs the declared set, so an
  # excluded package is never installed regardless.
  local label listcmd ignore_file
  label=$1; listcmd=$2; ignore_file=$3; shift 3
  local f files=()
  for f in "$@"; do [ -f "$f" ] && files+=("$f"); done
  if [ "${#files[@]}" -eq 0 ]; then info "$label: no manifest ($*) — skipping"; return; fi
  # Empty sets are legitimate (no foreign packages / comments-only manifest)
  # but exit non-zero from pacman -Qqm and grep -v — don't let -e/pipefail
  # abort the report over them.
  local installed manifest
  installed=$(eval "$listcmd" | sort -u) || true
  manifest=$(cat "${files[@]}" | grep -vE '^\s*(#|$)' | awk '{print $1}' | sort -u) || true
  local only_inst only_man
  only_inst=$(comm -23 <(printf '%s\n' "$installed") <(printf '%s\n' "$manifest"))
  only_man=$(comm -13 <(printf '%s\n' "$installed") <(printf '%s\n' "$manifest"))

  # Drop "installed but undeclared" packages that match the exclude patterns —
  # silently, no line and no count: they're the fleet's expected hardware/personal
  # tail, and reporting them at all is the noise this exclude mechanism removes.
  # What survives the filter is the real "installed but not in manifest" drift.
  local ignore_pats=() undeclared=()
  if [ -n "$ignore_file" ] && [ -f "$ignore_file" ]; then
    mapfile -t ignore_pats < <(grep -vE '^\s*(#|$)' "$ignore_file" | awk '{print $1}')
  fi
  if [ -n "$only_inst" ]; then
    local p pat matched
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      matched=0
      if [ "${#ignore_pats[@]}" -gt 0 ]; then
        for pat in "${ignore_pats[@]}"; do
          # shellcheck disable=SC2254  # $pat is an intentional glob pattern
          case "$p" in $pat) matched=1; break ;; esac
        done
      fi
      [ "$matched" -eq 1 ] || undeclared+=("$p")
    done <<<"$only_inst"
  fi

  # if, not `[ … ] && { … }`: a false final test would fail the function under -e.
  if [ "${#undeclared[@]}" -eq 0 ] && [ -z "$only_man" ]; then
    ok "$label: in sync"
  else
    if [ "${#undeclared[@]}" -gt 0 ]; then warn "$label: installed but not in manifest"; for p in "${undeclared[@]}"; do note "$p"; done; fi
    if [ -n "$only_man" ]; then warn "$label: in manifest but not installed"; while IFS= read -r p; do note "$p"; done <<<"$only_man"; fi
  fi
}
if have pacman; then
  pkg_diff "pacman (explicit)" "pacman -Qqe --native 2>/dev/null || pacman -Qqe" \
    packages/pacman-ignore.txt packages/pacman-base.txt packages/pacman.txt
  pkg_diff "AUR/foreign"       "pacman -Qqm" packages/aur-ignore.txt packages/aur.txt
else
  info "pacman not found — skipping"
fi
if have flatpak; then
  pkg_diff "flatpak" "flatpak list --app --columns=application" packages/flatpak-ignore.txt packages/flatpak.txt
fi

printf '\n%s——%s drift is informational; adopt configs / update manifests deliberately.\n' "$C_DIM" "$C_RST"
