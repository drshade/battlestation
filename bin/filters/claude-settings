#!/usr/bin/env bash
# claude-settings — git clean filter for stow/home/claude/.claude/settings.json.
#
# Claude Code rewrites its settings file at runtime: it inserts/updates
# session-state keys (model, effortLevel, alwaysThinkingEnabled, ...) and
# reorders keys wholesale. The tracked form is a WHITELIST projection of the
# deliberately-configured keys, sorted (jq -S) — default-deny, so a key
# Claude Code invents tomorrow never churns the repo (a deny-list had to
# learn each new key the hard way). The live file keeps everything; only
# what git sees is projected. `env` is kept for MCP_TOOL_TIMEOUT — the
# deliberate 2h ceiling that lets `bsctl mcp`'s long ask waits survive
# Claude Code's client-side tool timeout.
#
# This script is the single source of truth for the keep-list. Wired up via
# .gitattributes (filter=claude-settings) + repo-local git config:
#   git config filter.claude-settings.clean 'bin/filters/claude-settings'
# No smudge filter: checkout produces the projected form, and Claude Code
# re-adds its runtime keys on next run.
set -euo pipefail

jq -S '{hooks, permissions, statusLine, enabledPlugins, env} | with_entries(select(.value != null))'
