{
  "id": "claude-workspaces",
  "name": "Claude Workspaces",
  "version": "0.4.0",
  "minNoctaliaVersion": "4.4.3",
  "author": "tom",
  "license": "MIT",
  "description": "Workspace pills with an animated Claude Code bot per running instance, coloured by status (thinking / tool / waiting).",
  "tags": [
    "Bar"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "capitalizeNames": true,
      "showUsage": false,
      "overrideThemeColors": false,
      "outlinePills": false,
      "hideTrailing": true,
      "breathScale": 1.045,
      "breathMs": 1700,
      "activeMs": 1000,
      "waitS": 30,
      "jitter": 0.35,
      "focusedColor": "primary",
      "occupiedColor": "secondary",
      "emptyColor": "grey",
      "focusedCustom": "#5e81ac",
      "occupiedCustom": "#434c5e",
      "emptyCustom": "#3a3a3a"
    }
  }
}
