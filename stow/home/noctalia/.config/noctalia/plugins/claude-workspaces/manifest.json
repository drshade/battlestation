{
  "id": "claude-workspaces",
  "name": "Claude Workspaces",
  "version": "0.3.0",
  "minNoctaliaVersion": "4.4.3",
  "author": "tom",
  "license": "MIT",
  "description": "Workspace pills coloured by Claude Code status (thinking / running a tool / waiting / none).",
  "tags": [
    "Bar"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "displayMode": "pill",
      "capitalizeNames": true,
      "showUsage": false,
      "overrideThemeColors": false,
      "outlinePills": false,
      "hideTrailing": true,
      "breathScale": 1.045,
      "breathMs": 1700,
      "activeMs": 1000,
      "waitS": 30,
      "thinkingColor": "primary",
      "toolColor": "tertiary",
      "waitingColor": "error",
      "thinkingCustom": "#3fb950",
      "toolCustom": "#a371f7",
      "waitingCustom": "#c97b47",
      "focusedColor": "primary",
      "occupiedColor": "secondary",
      "emptyColor": "grey",
      "focusedCustom": "#5e81ac",
      "occupiedCustom": "#434c5e",
      "emptyCustom": "#3a3a3a"
    }
  }
}
