{
  "id": "battlestation-workspaces",
  "name": "Battlestation Workspaces",
  "version": "0.5.0",
  "minNoctaliaVersion": "4.4.3",
  "author": "tom",
  "license": "MIT",
  "description": "Workspace pills, live agent status, the Deck attention queue, and the Switchboard link manager.",
  "tags": [
    "Bar"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml",
    "panel": "Panel.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "asksHideDelivered": true,
      "capitalizeNames": true,
      "showUsage": false,
      "overrideThemeColors": false,
      "outlinePills": false,
      "hideTrailing": true,
      "activeMs": 1000,
      "waitS": 30,
      "jitter": 0.35,
      "focusedColor": "primary",
      "occupiedColor": "secondary",
      "emptyColor": "grey",
      "focusedCustom": "#5e81ac",
      "occupiedCustom": "#434c5e",
      "emptyCustom": "#3a3a3a"
    }
  }
}
