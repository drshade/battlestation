{
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh orange",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh green",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh green",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh purple",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh clear",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh orange",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh orange",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/claude-ws-status.sh green",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "preferredNotifChannel": "notifications_disabled",
  "statusLine": {
    "command": "bash $HOME/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen"
}
