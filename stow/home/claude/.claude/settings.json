{
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "env": {
    "MCP_TOOL_TIMEOUT": "7200000"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude waiting",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude thinking",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude thinking",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude tooling",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude clear",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude waiting",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude waiting",
            "type": "command"
          },
          {
            "command": "$HOME/.local/bin/bsctl asks retrigger",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude subagent-start",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude subagent-stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/bin/bsctl agents set --kind claude thinking",
            "type": "command"
          },
          {
            "command": "$HOME/.local/bin/bsctl asks inbox",
            "type": "command"
          },
          {
            "command": "$HOME/.local/bin/bsctl comms inbox",
            "type": "command"
          },
          {
            "command": "$HOME/.local/bin/bsctl asks inject",
            "type": "command"
          },
          {
            "command": "$HOME/.local/bin/bsctl asks retrigger mark",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "command": "bash $HOME/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  }
}
