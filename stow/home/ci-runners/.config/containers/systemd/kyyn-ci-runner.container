[Unit]
Description=Repository-scoped GitHub Actions runner for drshade/kyyn
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/kyyn-actions-runner:2.336.0
ContainerName=kyyn-ci-runner
Environment=RUNNER_REPOSITORY=drshade/kyyn
Environment=RUNNER_NAME=endor-kyyn-ci
Environment=RUNNER_LABELS=kyyn-ci
Environment=RUNNER_MANUALLY_TRAP_SIG=1
Secret=kyyn-ci-registration-token,type=env,target=RUNNER_TOKEN
Volume=kyyn-ci-state.volume:/runner:U
Volume=kyyn-ci-cache.volume:/cache:U
ReadOnly=true
Tmpfs=/tmp:rw,nodev,nosuid,size=4g
PodmanArgs=--cap-drop=all --security-opt=no-new-privileges --pids-limit=4096

[Service]
Slice=ci.slice
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=default.target
