{
  "battlestation-status": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "$HOME/.local/bin/bsctl agents set --kind agy thinking"
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "$HOME/.local/bin/bsctl agents set --kind agy waiting"
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/bsctl agents set --kind agy tooling"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/bsctl agents set --kind agy thinking"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "$HOME/.local/bin/bsctl agents set --kind agy waiting"
      }
    ]
  }
}