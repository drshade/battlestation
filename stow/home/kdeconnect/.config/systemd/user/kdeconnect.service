[Unit]
Description=KDE Connect daemon
Documentation=https://kdeconnect.kde.org/
# The package ships an XDG autostart entry, but the systemd-xdg-autostart
# generator marks it ConditionResult=no under uwsm/Hyprland, so it never
# actually launches. This dedicated unit makes the daemon reliable.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/kdeconnectd
Restart=on-failure
RestartSec=2
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
