# Secrets / machine-local state — never commit these
stow/home/fish/.config/fish/fish_variables
# Per-machine Hyprland monitor tuning (resolution/refresh); see setup/displays-00-*
stow/home/hypr/.config/hypr/config/monitors_local.lua
**/*.token
**/secrets*

# Private key material — never commit (public keys are allowed)
*.pem
*.key
*_rsa
*_dsa
*_ecdsa
*_ed25519
id_rsa
id_dsa
id_ecdsa
id_ed25519
!*.pub

# Claude Code (~/.claude): default-deny — track config only, never secrets/state.
# .credentials.json, projects/ (transcripts), history, caches can NEVER be
# committed, even if accidentally moved into the package.
stow/home/claude/.claude/**
!stow/home/claude/.claude/settings.json
!stow/home/claude/.claude/statusline.sh
!stow/home/claude/.claude/CLAUDE.md
!stow/home/claude/.claude/commands/
!stow/home/claude/.claude/commands/**
!stow/home/claude/.claude/agents/
!stow/home/claude/.claude/agents/**
!stow/home/claude/.claude/skills/
!stow/home/claude/.claude/skills/**
!stow/home/claude/.claude/hooks/
!stow/home/claude/.claude/hooks/**
!stow/home/claude/.claude/output-styles/
!stow/home/claude/.claude/output-styles/**

# Code-OSS (~/.config/Code - OSS): default-deny — track user settings only.
# globalStorage/workspaceStorage/History hold tokens, state and churn; only
# settings.json is config. Never add an ! rule that exposes the rest.
stow/home/code/.config/Code - OSS/**
!stow/home/code/.config/Code - OSS/
!stow/home/code/.config/Code - OSS/User/
!stow/home/code/.config/Code - OSS/User/settings.json

# Editor/OS noise
*.swp
.DS_Store
