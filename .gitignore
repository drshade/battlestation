# Secrets / machine-local state — never commit these
stow/home/fish/.config/fish/fish_variables
# Per-machine Hyprland monitor tuning (resolution/refresh); see setup/displays-00-*
stow/home/hypr/.config/hypr/config/monitors_local.lua
**/*.token
**/secrets*

# Private key material — never commit (public keys are allowed)
*.pem
*.key
*_rsa
*_dsa
*_ecdsa
*_ed25519
id_rsa
id_dsa
id_ecdsa
id_ed25519
!*.pub

# Claude Code (~/.claude): default-deny — track config only, never secrets/state.
# .credentials.json, projects/ (transcripts), history, caches can NEVER be
# committed, even if accidentally moved into the package.
stow/home/claude/.claude/**
!stow/home/claude/.claude/settings.json
!stow/home/claude/.claude/statusline.sh
!stow/home/claude/.claude/CLAUDE.md
!stow/home/claude/.claude/commands/
!stow/home/claude/.claude/commands/**
!stow/home/claude/.claude/agents/
!stow/home/claude/.claude/agents/**
!stow/home/claude/.claude/skills/
!stow/home/claude/.claude/skills/**
!stow/home/claude/.claude/hooks/
!stow/home/claude/.claude/hooks/**
!stow/home/claude/.claude/output-styles/
!stow/home/claude/.claude/output-styles/**

# Code-OSS (~/.config/Code - OSS): default-deny — track user settings only.
# globalStorage/workspaceStorage/History hold tokens, state and churn; only
# settings.json is config. Never add an ! rule that exposes the rest.
stow/home/code/.config/Code - OSS/**
!stow/home/code/.config/Code - OSS/
!stow/home/code/.config/Code - OSS/User/
!stow/home/code/.config/Code - OSS/User/settings.json

# Noctalia colors (~/.config/noctalia/colors.json): derived output, not config —
# regenerated (matugen-style) on every wallpaper/theme change. The wallpaper +
# color settings in settings.json are the source of truth; tracking the output
# would only churn.
stow/home/noctalia/.config/noctalia/colors.json

# Noctalia TEMPLATE outputs (same derived-output class as colors.json): the
# enabled templates in settings.json regenerate these into ~/.config on every
# theme change — they live at the target as REAL files the template engine
# owns (kitty's machinery even replaces current-theme.conf wholesale, which
# is why stow must not own these paths). A fresh machine gets them on the
# first theme apply.
stow/home/kitty/.config/kitty/themes/
stow/home/kitty/.config/kitty/current-theme.conf
stow/home/btop/.config/btop/themes/

# Noctalia plugins (~/.config/noctalia/plugins): default-deny — plugin code is
# installed/updated by Noctalia's plugin manager, and plugins.json (tracked)
# already records the source + enabled set; tracking third-party code here
# duplicates upstream and churns on every update. Opt-ins are only for plugins
# whose source of truth IS this repo.
stow/home/noctalia/.config/noctalia/plugins/*
!stow/home/noctalia/.config/noctalia/plugins/battlestation-workspaces/
!stow/home/noctalia/.config/noctalia/plugins/battlestation-workspaces/**
!stow/home/noctalia/.config/noctalia/plugins/battlestation-dictation/
!stow/home/noctalia/.config/noctalia/plugins/battlestation-dictation/**
!stow/home/noctalia/.config/noctalia/plugins/kde-connect/
!stow/home/noctalia/.config/noctalia/plugins/kde-connect/**

# Rust build output (ctl/): cargo-generated, never tracked
ctl/target/

# Local scratch space — not shipped in a published repo
scratch/

# Editor/OS noise
*.swp
.DS_Store
